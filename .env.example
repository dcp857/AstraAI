# Pooled URL for app traffic; direct URL for Prisma schema commands.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# A private single-user login. Use a long random password and secret.
APP_PASSWORD="replace-with-a-long-private-password"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Add one or both provider keys. Keys stay on the server.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_MODEL="gpt-5.6-sol"
ANTHROPIC_MODEL="claude-sonnet-5"

# Optional local Ollama provider (no API key required)
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="qwen3.5:4b"
